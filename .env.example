# Jannat Sahara Voyages — environment template.
#
# Copy to `.env` and fill in real values. `.env` is git-ignored; this template
# never carries a value. Never commit a real key.
#
#   cp .env.example .env
#
# Where to find these: Supabase dashboard -> Project Settings -> API.

# ---------------------------------------------------------------------------
# Supabase — browser (safe to ship in the client bundle)
# ---------------------------------------------------------------------------
# The `VITE_` copies are inlined by Vite at build time and are what the browser
# uses. The publishable/anon key is designed to be public; every table it can
# reach is protected by Row Level Security.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx
VITE_SUPABASE_PROJECT_ID=<project-ref>

# Same values, read during SSR where `import.meta.env` is not available.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx
SUPABASE_PROJECT_ID=<project-ref>

# ---------------------------------------------------------------------------
# Supabase — server only. NEVER prefix with VITE_.
# ---------------------------------------------------------------------------
# The service-role key bypasses Row Level Security completely. It is read only
# by src/integrations/supabase/client.server.ts and must never reach the
# browser, a client bundle, localStorage or a log line.
#
# REQUIRED: without it every admin server function, the CRM, the offer workflow
# and the Umrah Builder submission fail at startup.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Public site origin — used for canonical URLs, og:url, sitemap.xml, robots.txt
# ---------------------------------------------------------------------------
# Optional. When unset, canonical links stay relative and the sitemap omits its
# absolute base. `site_settings.seo_canonical_base` is the fallback source; this
# variable wins when both are set.
VITE_SITE_URL=https://example.tn

# ---------------------------------------------------------------------------
# Transactional email (Resend) — server only
# ---------------------------------------------------------------------------
# Optional. When unset, notification emails are skipped and logged; bookings,
# flight requests and Umrah requests are still stored normally.
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
BOOKING_NOTIFICATION_EMAIL=

# ---------------------------------------------------------------------------
# Local tooling only — never needed by the running application
# ---------------------------------------------------------------------------
# Used by `npm run db:push` to apply supabase/migrations to the linked project.
# Supabase dashboard -> Account -> Access Tokens.
SUPABASE_ACCESS_TOKEN=
